<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0-ios</TargetFramework>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <SupportedOSPlatformVersion>12.2</SupportedOSPlatformVersion>
        <ApplicationId>com.maplibre.tests.ios</ApplicationId>
        <ApplicationDisplayName>MapLibre Tests iOS</ApplicationDisplayName>
        <ApplicationVersion>1.0</ApplicationVersion>
        <!-- Disable AOT for test projects to avoid compilation issues -->
        <UseFullAotCompilation>false</UseFullAotCompilation>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <MtouchLink>None</MtouchLink>
        <MtouchDebug>true</MtouchDebug>
        <!-- Disable AOT for debug builds -->
        <UseFullAotCompilation>false</UseFullAotCompilation>
        <UseInterpreter>true</UseInterpreter>
    </PropertyGroup>
    
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <MtouchLink>SdkOnly</MtouchLink>
        <!-- Keep AOT disabled for test projects even in release -->
        <UseFullAotCompilation>false</UseFullAotCompilation>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.2"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0"/>
        <PackageReference Include="xunit" Version="2.9.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
      <None Include="Info.plist" />
    </ItemGroup>

</Project>
